# =============================================================================
#  Apache-Konfiguration – Dentaviva (Hetzner Webhosting, Apache 2.4)
#
#  NICHT HIER BEARBEITEN, WENN DU NUR DIE WEBSITE PFLEGST:
#  Diese Datei wird bei jedem Build aus server/htaccess.vorlage erzeugt
#  (scripts/htaccess.mjs). Die Content-Security-Policy wird aus src/config/site.ts berechnet
#  (Doctolib-Widget, Statistik). Änderungen bitte in der Vorlage machen.
# =============================================================================

Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .xml .html .css .js

# -----------------------------------------------------------------------------
#  HTTPS erzwingen und www → ohne www ({{HOST}})
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^{{HOST_REGEX}}$ [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
  RewriteRule ^ https://{{HOST}}%{REQUEST_URI} [R=301,L]
</IfModule>

# -----------------------------------------------------------------------------
#  301-Weiterleitungen: alte URLs der bisherigen Website → neue Seiten
#  (/leistungen/ und /impressum/ bleiben gleich)
# -----------------------------------------------------------------------------
<IfModule mod_alias.c>
  RedirectMatch 301 ^/die-praxis/?$            /praxis-team/
  RedirectMatch 301 ^/uber-dr-adali/?$         /ueber-dr-adali/
  RedirectMatch 301 ^/kontakt-and-infos/?$     /termin-kontakt/
  RedirectMatch 301 ^/datenschutzerklarung/?$  /datenschutz/
</IfModule>

# -----------------------------------------------------------------------------
#  Fehlerseiten je Sprache
# -----------------------------------------------------------------------------
ErrorDocument 404 /404.html
<If "%{REQUEST_URI} =~ m#^/en/#">
  ErrorDocument 404 /en/404/index.html
</If>
<If "%{REQUEST_URI} =~ m#^/es/#">
  ErrorDocument 404 /es/404/index.html
</If>
<If "%{REQUEST_URI} =~ m#^/tr/#">
  ErrorDocument 404 /tr/404/index.html
</If>

# -----------------------------------------------------------------------------
#  Sicherheit
# -----------------------------------------------------------------------------
# Versteckte Dateien (.git, .env …) und Zugangsdaten nie ausliefern; Let's-Encrypt-Prüfung erlauben
<IfModule mod_rewrite.c>
  RewriteRule "(^|/)\.(?!well-known/)" - [F]
</IfModule>
<FilesMatch "^(anfrage-konfiguration\.php|.*\.(md|log|sh|bak|sql|ini|env))$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # HSTS: Browser verwenden zwei Jahre lang nur HTTPS. Erst aktivieren, wenn HTTPS
  # (Let's Encrypt in der konsoleH) sicher läuft – siehe README, Abschnitt „TLS“.
  Header always set Strict-Transport-Security "max-age=63072000" env=HTTPS
  Header always set Content-Security-Policy "{{CSP}}"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header unset X-Powered-By
  # Keine Cookies: diese Website setzt keine. (PHP-Sitzungen werden nicht genutzt.)
</IfModule>

# -----------------------------------------------------------------------------
#  Dateitypen
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType application/xml .xml
  AddType text/plain .txt
  AddType application/manifest+json .webmanifest
</IfModule>

# -----------------------------------------------------------------------------
#  Komprimierung
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript image/svg+xml application/json
</IfModule>

# -----------------------------------------------------------------------------
#  Caching
#  - /_astro/ und /fonts/: Dateinamen ändern sich bei jeder Änderung → 1 Jahr, unveränderlich
#  - HTML, txt, xml: immer neu prüfen, damit Änderungen sofort sichtbar sind
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css|avif|webp|jpg|jpeg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/(_astro|fonts)/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
