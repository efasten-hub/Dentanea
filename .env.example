# Kopieren nach .env und ausfüllen. .env wird nie eingecheckt.
# Stockfoto-Suche (optional) – ohne Schlüssel funktioniert der Weg über eingetragene Fotoseiten.
UNSPLASH_ACCESS_KEY=[[API-KEY]]
# Pexels vergibt derzeit (Okt. 2026) keine neuen Schlüssel – optional, das Skript läuft auch nur mit Unsplash.
PEXELS_API_KEY=
