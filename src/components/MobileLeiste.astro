---
/**
 * Schlanke, fixierte Leiste unten – nur auf dem Handy.
 * Weiß, 1px-Haarlinie oben, kleine Labels (14px, DESIGN.md Abschnitt 5):
 * Online-Termin · Anrufen · Anfahrt. Kein WhatsApp (Gesundheitsdaten, DSGVO).
 */
interface Eintrag { href: string; label: string; extern?: boolean; externHinweis?: string }
interface Props { eintraege: Eintrag[]; label: string }
const { eintraege, label } = Astro.props;
// Feste Klassen statt Inline-Style – kompatibel mit einer strikten Content-Security-Policy
const spalten = ["grid-cols-1", "grid-cols-2", "grid-cols-3", "grid-cols-4"][eintraege.length - 1] ?? "grid-cols-3";
---
<nav
  aria-label={label}
  class="fixed inset-x-0 bottom-0 z-40 border-t border-linie bg-cream-paper pb-[env(safe-area-inset-bottom)] md:hidden"
>
  <ul class:list={["grid", spalten]}>
    {eintraege.map((e, i) => (
      <li class:list={[i > 0 && "border-l border-linie"]}>
        <a
          href={e.href}
          target={e.extern ? "_blank" : undefined}
          rel={e.extern ? "noopener" : undefined}
          class="label flex min-h-56 items-center justify-center px-8 text-center no-underline"
        >
          {e.label}
          {e.extern && e.externHinweis && <span class="sr-only"> ({e.externHinweis})</span>}
        </a>
      </li>
    ))}
  </ul>
</nav>
