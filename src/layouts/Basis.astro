---
/**
 * Grundlayout aller öffentlichen Seiten.
 * - <html lang> pro Sprache, Canonical selbstreferenzierend
 * - hreflang nur für tatsächlich vorhandene Sprachfassungen, x-default → Deutsch
 * - Open Graph mit og:locale und og:locale:alternate (OG-Bilder folgen in Phase 3/5)
 * - Hinweis für fehlende Übersetzungen per CSS :target – ohne JavaScript, ohne Cookie
 */
import "../styles/global.css";
import { site, type Sprache } from "../config/site";
import { t, alternativen as holeAlternativen, link, terminZiel, STANDARD } from "../i18n";
import { routen } from "../i18n/routen";
import { getEntry } from "astro:content";
import { jsonLd } from "../lib/schema";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileLeiste from "../components/MobileLeiste.astro";
import BrowserSprachHinweis from "../components/BrowserSprachHinweis.astro";

interface Props {
  sprache: Sprache;
  seitenId: string;
  /** <title>, höchstens 60 Zeichen */
  titel: string;
  /** Meta-Description, höchstens 155 Zeichen */
  beschreibung: string;
  noindex?: boolean;
}
const { sprache, seitenId, titel, beschreibung, noindex = routen[seitenId]?.noindex ?? false } = Astro.props;

const alternativen = await holeAlternativen(seitenId);
const vorhandene = alternativen.filter((a) => a.vorhanden);
const absolut = (p: string) => new URL(p, site.domain).href;
const canonical = absolut(Astro.url.pathname);
const deVorhanden = vorhandene.find((a) => a.sprache === STANDARD);
// Hinweise „noch nicht übersetzt“ gibt es nur auf deutschen Seiten (Ziel des Umschalters)
const fehlend = sprache === STANDARD ? alternativen.filter((a) => !a.vorhanden) : [];

const kontakt = await link("kontakt", sprache);
const tb = site.terminbuchung;
const ziel = await terminZiel(sprache);
const leiste = [
  ziel.online
    ? { href: ziel.href, label: t(sprache, "termin.online_kurz"), extern: ziel.extern, externHinweis: `${t(sprache, "termin.ueber_anbieter", { anbieter: tb.anbieter_name })}, ${t(sprache, "a11y.neues_fenster")}` }
    : { href: ziel.href, label: t(sprache, "termin.anfrage_link") },
  { href: `tel:${site.telefon}`, label: t(sprache, "termin.anrufen_kurz") },
  { href: `${kontakt}#anfahrt`, label: t(sprache, "anfahrt.titel") },
];
// Strukturierte Daten (nur indexierbare Seiten); JSON in <script type="application/ld+json"> ist ein Datenblock, kein ausführbares Skript (CSP-neutral)
const graph = noindex ? null : await jsonLd(seitenId, sprache);
const ldJson = graph ? JSON.stringify(graph).replace(/</g, "\\u003c") : null;
const istArtikel = routen[seitenId]?.typ === "ratgeber";
const artikelDaten = istArtikel ? (await getEntry("seiten", `${sprache}/${seitenId}`))?.data : undefined;
// Türkische Seiten brauchen sofort die latin-ext-Schnitte (ğ ş ı İ)
const preloads = [
  "libre-caslon-display-latin-400-normal",
  "inter-latin-400-normal",
  ...(sprache === "tr" ? ["inter-latin-ext-400-normal", "libre-caslon-display-latin-ext-400-normal"] : []),
];
---
<!doctype html>
<html lang={sprache}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    {!noindex && vorhandene.map((a) => <link rel="alternate" hreflang={a.sprache} href={absolut(a.href)} />)}
    {!noindex && deVorhanden && <link rel="alternate" hreflang="x-default" href={absolut(deVorhanden.href)} />}

    <meta property="og:type" content={istArtikel ? "article" : "website"} />
    {artikelDaten?.datum && <meta property="article:published_time" content={artikelDaten.datum} />}
    {istArtikel && <meta property="article:author" content={site.inhaber.name_voll} />}
    <meta property="og:site_name" content={site.praxisname_voll} />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.sprachen.og_locale[sprache]} />
    {vorhandene.filter((a) => a.sprache !== sprache).map((a) => <meta property="og:locale:alternate" content={site.sprachen.og_locale[a.sprache]} />)}
    <meta property="og:image" content={absolut(`/og/${sprache}/${seitenId}.jpg`)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={titel} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {preloads.map((f) => <link rel="preload" href={`/fonts/${f}.woff2`} as="font" type="font/woff2" crossorigin />)}
    <meta name="geo.region" content="DE-BE" />
    <meta name="geo.placename" content={site.adresse.ort} />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />
    <link rel="alternate" type="text/plain" href={sprache === STANDARD ? "/llms.txt" : `/${sprache}/llms.txt`} title="llms.txt" />
    {ldJson && <script type="application/ld+json" set:html={ldJson} />}
    <slot name="head" />
  </head>
  <body class="pb-[calc(57px+env(safe-area-inset-bottom))] md:pb-0">
    <a href="#inhalt" class="sr-only focus:not-sr-only focus:absolute focus:left-16 focus:top-16 focus:z-50 focus:bg-cream-paper focus:p-12">{t(sprache, "a11y.zum_inhalt")}</a>
    <BrowserSprachHinweis sprache={sprache} alternativen={alternativen} />
    <Header sprache={sprache} seitenId={seitenId} alternativen={alternativen} />

    {fehlend.map((a) => (
      <div id={`uebersetzung-fehlt-${a.sprache}`} class="hinweis-ziel border-b border-oxblood-ink bg-aged-linen" lang={a.sprache} role="note">
        <p class="container-page py-12 text-nav">{t(a.sprache, "sprachen.nicht_uebersetzt")}</p>
      </div>
    ))}

    <main id="inhalt" tabindex="-1">
      <slot />
    </main>

    <Footer sprache={sprache} alternativen={alternativen} />
    <MobileLeiste label={t(sprache, "a11y.schnellzugriff")} eintraege={leiste} />
  </body>
</html>
