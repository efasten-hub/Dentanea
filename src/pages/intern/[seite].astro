---
/**
 * INTERNE Vorschau des Designsystems (Phase-1-Checkpoint).
 * noindex, nicht in der Sitemap. Existiert nur mit `npm run dev` (/intern/designsystem)
 * oder mit INTERN=1 npm run build – ein normaler Produktions-Build erzeugt sie nicht.
 * Inhalte sind Musterdaten – echte Praxisdaten kommen in Phase 2 aus src/config/site.ts.
 */
import type { GetStaticPaths } from "astro";
import "../../styles/global.css";

export const getStaticPaths = (() =>
  import.meta.env.DEV || process.env.INTERN === "1" ? [{ params: { seite: "designsystem" } }] : []) satisfies GetStaticPaths;
import { Picture } from "astro:assets";
import Sprachumschalter from "../../components/Sprachumschalter.astro";
import MobileLeiste from "../../components/MobileLeiste.astro";
import portraet from "../../assets/fotos/dr-ufuk-adali-portraet.jpg";
import logo from "../../assets/logo/logo-platzhalter.svg";

// Vorläufig hier – wandert in Phase 2 nach src/config/site.ts
const doctolib = "https://www.doctolib.de/zahnarztpraxis/berlin/zahnarztpraxis-dr-adali";
const tel = "tel:+49304426843";

const sprachen = [
  { code: "de", href: "#", name: "Deutsch" },
  { code: "en", href: "#", name: "English" },
  { code: "es", href: "#", name: "Español" },
  { code: "tr", href: "#", name: "Türkçe" },
];
const alternativen = sprachen.map((s) => ({ sprache: s.code as "de" | "en" | "es" | "tr", href: s.href, vorhanden: true }));
const nav = ["Leistungen", "Über Dr. Adali", "Praxis & Team", "Ratgeber", "FAQ", "Termin & Kontakt"];

const farben = [
  { name: "Oxblood Ink", token: "--color-oxblood-ink", hex: "#4a0a05", bg: "bg-oxblood-ink", herkunft: "Export", rolle: "Text, Linien, Links, Buttons", kontrast: "15,0 : 1 · AAA" },
  { name: "Cream Paper", token: "--color-cream-paper", hex: "#fafaf9", bg: "bg-cream-paper", herkunft: "Export", rolle: "Seitenfläche", kontrast: "Fläche" },
  { name: "Aged Linen", token: "--color-aged-linen", hex: "#f8f7f1", bg: "bg-aged-linen", herkunft: "Export", rolle: "stille Zweitfläche", kontrast: "Fläche · Ink 14,6 : 1" },
  { name: "Warm Stone", token: "--color-warm-stone", hex: "#bcb6a6", bg: "bg-warm-stone", herkunft: "Export", rolle: "Fläche/Trennlinie, darauf nur Ink", kontrast: "Fläche · Ink 7,8 : 1" },
  { name: "Dusty Clay", token: "--color-dusty-clay", hex: "#a2827f", bg: "bg-dusty-clay", herkunft: "Export", rolle: "für Text gesperrt", kontrast: "3,3 : 1 · fällt durch" },
  { name: "Oxblood Muted", token: "--color-oxblood-muted", hex: "#764642", bg: "bg-oxblood-muted", herkunft: "Ergänzung A2", rolle: "Sekundärtext, Captions", kontrast: "7,4 : 1 · AAA" },
  { name: "Oxblood Subtle", token: "--color-oxblood-subtle", hex: "#885e5a", bg: "bg-oxblood-subtle", herkunft: "Ergänzung A2", rolle: "Untergrenze, Platzhalter", kontrast: "5,3 : 1 · AA" },
];

const stufen = [
  { cls: "hero-title", name: "Hero · Caslon Display", groesse: "42→76px · Abweichung" },
  { cls: "text-display font-caslon-display", name: "H1 · Caslon Display", groesse: "36→56px · Abweichung" },
  { cls: "text-title font-caslon-display", name: "H2 · Caslon Display", groesse: "28→40px · Abweichung" },
  { cls: "text-subheading font-caslon-ionic", name: "Subheading · Caslon Text", groesse: "24px · Export" },
  { cls: "text-heading font-mier-a", name: "Heading/Intro · Inter", groesse: "26px · Export" },
  { cls: "text-body font-mier-a", name: "Body · Inter", groesse: "18px · Export" },
  { cls: "text-nav font-mier-a", name: "Navigation · Inter", groesse: "16px · statt 14px" },
  { cls: "text-caption font-mier-a", name: "Caption · Inter", groesse: "14px · statt 13px" },
];

const zeichenproben = [
  { lang: "de", text: "Zähne, Brücken & Größe – „Kreidezähne“ (MIH) · Prüfung für Ärztinnen" },
  { lang: "en", text: "Resin-bonded bridge (Maryland bridge) · English-speaking dentist" },
  { lang: "es", text: "¿Puente adhesivo? ¡Sí! · Niño, España, implantación, Odontología" },
  { lang: "tr", text: "Diş hekimi · Yapışkan köprü · Ağız, çene, Iğdır, İstanbul, şikâyet, ışık" },
];

const schwerpunkte = [
  { t: "Zahnersatz", m: "Kronen, Brücken, Prothesen" },
  { t: "Implantologie", m: "Planung, Sofortversorgung" },
  { t: "Ästhetik", m: "Veneers, Bleaching, Aligner" },
  { t: "CMD & Schienen", m: "Knirschen, Kiefergelenk" },
];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Designsystem (intern) · Dentanea – Zahnarztpraxis Dr. Adali</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/libre-caslon-display-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="pb-[calc(57px+env(safe-area-inset-bottom))] md:pb-0">
    <a href="#inhalt" class="sr-only focus:not-sr-only focus:absolute focus:left-16 focus:top-16 focus:z-50 focus:bg-cream-paper focus:p-12">Zum Inhalt springen</a>

    <!-- ===================== Header (A8) ===================== -->
    <header class="border-b border-oxblood-ink">
      <div class="container-page flex flex-wrap items-center justify-between gap-x-32 gap-y-4 py-12">
        <a href="#" class="inline-flex min-h-44 items-center gap-12 no-underline">
          <img src={logo.src} width="44" height="44" alt="" />
          <span class="flex flex-col">
            <span class="font-caslon-ionic text-subheading leading-[1]">Dentanea</span>
            <span class="caption mt-4">Zahnarztpraxis Dr. Adali</span>
          </span>
        </a>
        <div class="flex flex-wrap items-center gap-x-24 gap-y-8">
          <Sprachumschalter aktuell="de" alternativen={alternativen} label="Sprache wählen" class="whitespace-nowrap" />
          <a href={tel} class="nav-link hidden whitespace-nowrap md:inline-flex">030 44 26 84 3</a>
          <a href={doctolib} target="_blank" rel="noopener" class="btn btn-primary btn-compact hidden whitespace-nowrap md:inline-flex">
            Online-Termin<span class="sr-only"> (über Doctolib, öffnet in neuem Fenster)</span>
          </a>
        </div>
      </div>
      <details class="menue border-t border-oxblood-ink lg:hidden">
        <summary class="container-page label flex min-h-48 cursor-pointer list-none items-center justify-between">
          <span>Menü</span><span aria-hidden="true" class="menue-zeichen">+</span>
        </summary>
        <nav aria-label="Hauptnavigation (mobil)" class="container-page border-t border-oxblood-ink pb-24">
          <ul>
            {nav.map((n, i) => (
              <li class="border-b border-oxblood-ink"><a class="nav-link min-h-48 w-full justify-start" href="#" aria-current={i === 0 ? "page" : undefined}>{n}</a></li>
            ))}
          </ul>
          <Sprachumschalter aktuell="de" alternativen={alternativen} label="Sprache wählen (Menü)" class="mt-16" />
          <a href={tel} class="btn btn-outline mt-16 w-full">030 44 26 84 3 anrufen</a>
        </nav>
      </details>
      <nav aria-label="Hauptnavigation" class="hidden border-t border-oxblood-ink lg:block">
        <ul class="container-page flex flex-wrap gap-x-24 py-4">
          {nav.map((n, i) => (
            <li><a class="nav-link" href="#" aria-current={i === 0 ? "page" : undefined}>{n}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="inhalt">
      <!-- ===================== Hero (A7): Text neben dem Foto, nie darauf ===================== -->
      <section class="container-page grid gap-40 py-48 md:grid-cols-2 md:items-end md:py-80">
        <div>
          <p class="caption mb-24">Designsystem · Phase 1</p>
          <h1 class="hero-title">Zahnmedizin auf universitärem Niveau.</h1>
          <p class="intro mt-24 text-oxblood-muted">Dentanea · Zahnarztpraxis Dr. Adali · Schönhauser Allee, Berlin-Mitte</p>
          <div class="mt-40 flex flex-wrap gap-12">
            <a href={doctolib} class="btn btn-primary" target="_blank" rel="noopener">
              Online-Termin buchen<span class="sr-only"> (öffnet in neuem Fenster)</span>
            </a>
            <a href={tel} class="btn btn-outline">030 44 26 84 3 anrufen</a>
          </div>
          <p class="caption mt-12">über Doctolib</p>
        </div>
        <div class="foto-folgt aspect-[4/3] w-full">
          <span class="label max-w-[24ch] px-24 text-center">Hero-Bild: atmosphärisches Stockfoto ohne Personen (Phase 3)</span>
        </div>
      </section>

      <!-- Vertrauensleiste -->
      <section aria-label="Qualifikationen" class="border-y border-oxblood-ink">
        <ul class="container-page flex flex-wrap items-center gap-x-16 gap-y-4 py-20 text-nav">
          <li>Charité</li><li aria-hidden="true">·</li>
          <li>DGPro</li><li aria-hidden="true">·</li>
          <li>DGI</li><li aria-hidden="true">·</li>
          <li>Zahnärztekammer Berlin</li><li aria-hidden="true">·</li>
          <li>eigenes Labor</li>
        </ul>
      </section>

      <!-- ===================== Schwerpunkt-Raster (Product Category Card) ===================== -->
      <section class="container-page section">
        <div class="sektion-kopf">
          <p class="label">Schwerpunkte</p>
          <h2>Wofür Patienten aus ganz Berlin kommen</h2>
        </div>
        <ul class="mt-40 grid gap-x-12 gap-y-40 sm:grid-cols-2 lg:grid-cols-4">
          {schwerpunkte.map((s) => (
            <li>
              <div class="foto-folgt aspect-[4/3]"><span class="label">Stockfoto (Phase 3)</span></div>
              <h3 class="mt-12">{s.t}</h3>
              <p class="caption mt-4">{s.m}</p>
              <a href="#" class="link-action mt-4">Mehr erfahren<span class="sr-only"> zu {s.t}</span></a>
            </li>
          ))}
        </ul>
      </section>

      <!-- ===================== Teaser Dr. Adali mit echtem Porträt ===================== -->
      <section class="container-page section">
        <div class="sektion-kopf">
          <p class="label">Über Dr. Adali</p>
          <div class="grid gap-40 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:items-start">
            <Picture
              src={portraet}
              formats={["avif", "webp"]}
              widths={[320, 480, 640, 960, 1280]}
              sizes="(min-width: 768px) 40vw, 100vw"
              alt="Porträt von Dr. Ufuk Adali"
              class="w-full"
              loading="lazy"
            />
            <div>
              <h2>Dr. Ufuk Adali</h2>
              <p class="intro mt-24">Viele Jahre leitender Oberarzt an der Charité – Universitätsmedizin Berlin. Spezialist für Prothetik (DGPro), zertifizierter Implantologe (DGI).</p>
              <p class="mt-24 max-w-text">Musterabsatz in 18px mit Zeilenhöhe 1.6 – so liest sich längerer Fließtext auch für ältere Patienten angenehm. Der Export sah 1.2 vor; die Anpassung ist in DESIGN.md (A4) begründet.</p>
              <a href="#" class="link-action mt-16">Werdegang und Qualifikationen</a>
            </div>
          </div>
        </div>
      </section>

      <!-- ===================== Terminbuchung (Muster, Modus „link“) ===================== -->
      <section class="container-page section">
        <div class="sektion-kopf">
          <p class="label">Termin</p>
          <div class="bg-aged-linen p-24 md:p-40">
            <h2>Termin vereinbaren</h2>
            <p class="mt-16 max-w-text">Termine können Sie rund um die Uhr online über Doctolib buchen – oder telefonisch während der Sprechzeiten.</p>
            <div class="mt-24 flex flex-wrap gap-12">
              <a href={doctolib} class="btn btn-primary" target="_blank" rel="noopener">Online-Termin buchen<span class="sr-only"> (öffnet in neuem Fenster)</span></a>
              <a href={tel} class="btn btn-outline">030 44 26 84 3 anrufen</a>
            </div>
            <p class="caption mt-12">über Doctolib · öffnet in neuem Fenster</p>
          </div>
        </div>
      </section>

      <!-- ===================== Farben ===================== -->
      <section class="container-page section">
        <div class="sektion-kopf">
          <p class="label">Farben</p>
          <div>
            <h2>Farben &amp; Kontraste</h2>
            <p class="mt-16 max-w-text text-oxblood-muted">Alle Tokens des Exports 1:1. Dusty Clay ist für Text gesperrt (3,3 : 1); dafür zwei geprüfte Oxblood-Abstufungen.</p>
            <ul class="mt-40 grid gap-x-24 sm:grid-cols-2 lg:grid-cols-4">
              {farben.map((f) => (
                <li class="border-t border-oxblood-ink py-24">
                  <div class:list={["mb-16 h-80 border border-oxblood-ink", f.bg]}></div>
                  <h3>{f.name}</h3>
                  <p class="caption mt-4">{f.hex} · <code>{f.token}</code></p>
                  <p class="mt-8 text-nav">{f.rolle}</p>
                  <p class="caption mt-4">{f.herkunft} · {f.kontrast}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- ===================== Typografie ===================== -->
      <section class="container-page section">
        <div class="sektion-kopf">
          <p class="label">Typografie</p>
          <div>
            <h2>Acht Stufen, nur Gewicht 400</h2>
            <div class="mt-40">
              {stufen.map((s) => (
                <div class="grid gap-8 border-t border-oxblood-ink py-24 md:grid-cols-[200px_1fr]">
                  <div>
                    <p class="text-nav">{s.name}</p>
                    <p class="caption">{s.groesse}</p>
                  </div>
                  <p class={s.cls}>Implantat oder Klebebrücke?</p>
                </div>
              ))}
            </div>
            <h3 class="mt-60">Sonderzeichen in allen Schnitten</h3>
            <div class="mt-24">
              {zeichenproben.map((z) => (
                <div lang={z.lang} class="grid gap-12 border-t border-oxblood-ink py-20 md:grid-cols-[60px_1fr]">
                  <p class="label">{z.lang.toUpperCase()}</p>
                  <div class="space-y-8">
                    <p class="font-caslon-display text-title">{z.text}</p>
                    <p class="font-caslon-ionic text-subheading">{z.text}</p>
                    <p>{z.text}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ===================== Formular ===================== -->
      <section class="container-page section">
        <div class="sektion-kopf">
          <p class="label">Formular</p>
          <form class="grid max-w-text gap-24" action="#" method="get">
            <label class="grid gap-8"><span class="text-nav">Name</span><input class="field" type="text" autocomplete="name" /></label>
            <label class="grid gap-8"><span class="text-nav">Anliegen</span>
              <select class="field"><option>Erstberatung</option><option>Zweitmeinung</option><option>Implantat</option></select>
            </label>
            <label class="grid gap-8"><span class="text-nav">Nachricht <span class="text-oxblood-muted">(optional)</span></span><textarea class="field" rows="4" placeholder="Bitte keine Befunde – die bringen Sie gern mit."></textarea></label>
            <div><button class="btn btn-primary" type="button">Anfrage senden</button></div>
          </form>
        </div>
      </section>
    </main>

    <!-- ===================== Footer (A10) ===================== -->
    <footer class="border-t border-oxblood-ink">
      <div class="container-page grid gap-32 py-60 md:grid-cols-3">
        <div>
          <p class="font-caslon-ionic text-subheading">Dentanea</p>
          <p class="caption">Zahnarztpraxis Dr. Adali</p>
          <p class="mt-8 text-nav">Schönhauser Allee 10–11<br />10119 Berlin</p>
        </div>
        <ul class="text-nav">
          <li><a class="nav-link justify-start" href={tel}>030 44 26 84 3</a></li>
          <li><a class="nav-link justify-start" href="mailto:kontakt@zahnarzt-adali.de">kontakt@zahnarzt-adali.de</a></li>
        </ul>
        <Sprachumschalter aktuell="de" alternativen={alternativen} label="Sprache wählen (Fußzeile)" />
      </div>
    </footer>

    <MobileLeiste
      label="Schnellzugriff"
      eintraege={[
        { href: doctolib, label: "Online-Termin", extern: true, externHinweis: "über Doctolib, öffnet in neuem Fenster" },
        { href: tel, label: "Anrufen" },
        { href: "#", label: "Anfahrt" },
      ]}
    />
  </body>
</html>
