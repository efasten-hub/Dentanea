# =============================================================================
#  Apache-Konfiguration – Dentaviva (Hetzner Webhosting)
#  Phase 5: Weiterleitungen der alten Website. Caching, Sicherheits-Header (CSP,
#  HSTS …), HTTPS-Zwang und Fehlerseiten folgen in Phase 7.
# =============================================================================

# -----------------------------------------------------------------------------
#  301-Weiterleitungen: alte URLs (MyWebsite NOW) → neue Seiten
#  Erhält Google-Ranking und Links von außen. Gleichbleibende Adressen
#  (/leistungen/, /impressum/) brauchen keine Weiterleitung.
# -----------------------------------------------------------------------------
<IfModule mod_alias.c>
  RedirectMatch 301 ^/die-praxis/?$            /praxis-team/
  RedirectMatch 301 ^/uber-dr-adali/?$         /ueber-dr-adali/
  RedirectMatch 301 ^/kontakt-and-infos/?$     /termin-kontakt/
  RedirectMatch 301 ^/datenschutzerklarung/?$  /datenschutz/
  RedirectMatch 301 ^/leistungen$              /leistungen/
  RedirectMatch 301 ^/impressum$               /impressum/
</IfModule>

# Zeichensatz: Umlaute und türkische Zeichen in llms.txt, robots.txt und Sitemap korrekt ausliefern
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .xml .html

# Zugangsdaten des Anfrageformulars nie ausliefern (falls im Web-Verzeichnis abgelegt)
<Files "anfrage-konfiguration.php">
  Require all denied
</Files>
